# Server
NODE_ENV=development        # development | staging | production
PORT=4000

# Database (never commit real credentials — inject via CI/CD secrets or a vault in higher envs)
PGHOST=localhost
PGPORT=5432
PGDATABASE=document_reader
PGUSER=doc_reader_app
PGPASSWORD=change-me

# Uploads
MAX_UPLOAD_MB=20
UPLOAD_DIR=./uploads

# Security
# Only needed if you serve the frontend from a different origin than the
# API (e.g. a separate static host). Leave unset for the default setup,
# where Express serves both from :4000 and everything is same-origin.
# CORS_ORIGIN=http://localhost:5173
CSRF_COOKIE_NAME=dr_csrf
SESSION_SECRET=change-me-too

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_COOKIE_NAME=dr_session
JWT_EXPIRES_IN=8h
# Comma-separated emails that get the admin role on first registration —
# every other registration defaults to 'user'. Bootstraps the org without
# a chicken-and-egg "who promotes the first admin" problem.
BOOTSTRAP_ADMIN_EMAILS=you@example.com
